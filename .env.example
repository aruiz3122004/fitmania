# Plantilla de variables de entorno de FITMANIA. Copiar a .env.local (desarrollo) o
# cargarlas en Vercel → Settings → Environment Variables (Production / Preview).
# Nunca poner valores reales en este archivo: se versiona.
# Dónde se consigue cada una: docs/servicios.md. Cómo rotarlas: docs/runbook.md.
# [C] = crítica (sin ella la app no opera; /api/health falla) · [R] = recomendada (apaga una función)

# ── Firebase (cliente) ─ Consola Firebase → Configuración del proyecto → Tus apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=            # [C]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=         # [C]
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=          # [R] push: Cloud Messaging → Certificados push web
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY= # [R] App Check

# ── Firebase Admin ─ Configuración → Cuentas de servicio → Generar clave privada
FIREBASE_PROJECT_ID=                     # [C]
FIREBASE_CLIENT_EMAIL=                   # [C]
FIREBASE_PRIVATE_KEY_B64=                # [C] la clave PEM en base64 (o FIREBASE_PRIVATE_KEY con \n)

# ── Mercado Pago ─ developers → Tus integraciones → la aplicación → Credenciales de producción / Webhooks
MERCADOPAGO_ACCESS_TOKEN=                # [C] APP_USR-... (TEST-... en staging)
MERCADOPAGO_WEBHOOK_SECRET=              # [C] de la MISMA aplicación que el access token
# Solo desarrollo, nunca en producción:
# MERCADOPAGO_PUBLIC_URL=https://<túnel>  # para recibir webhooks en local
# MERCADOPAGO_API_URL=http://localhost:4010 # simulador local de la API

# ── Paneles ocultos y roles
ADMIN_GATE_KEY=                          # [C] secreto largo aleatorio (openssl rand -hex 32)
RECEPTION_GATE_KEY=                      # [C] distinto del anterior
ADMIN_AUTHORIZED_EMAIL=
RECEPTION_AUTHORIZED_EMAIL=
ADMIN_REQUIRE_MFA=true                   # exige TOTP o código por correo al admin
INTERNAL_MIDDLEWARE_SECRET=              # [R]
CRON_SECRET=                             # [R] Vercel lo envía al cron diario

# ── Correo (Resend) ─ resend.com → API Keys; dominio verificado en Domains
RESEND_API_KEY=                          # [R]
MAIL_FROM="Fitmania <no-reply@tudominio.com>"
ADMIN_COPY_EMAIL=                        # copia oculta de recibos (no se usa en códigos MFA)

# ── Límite de peticiones (Upstash Redis) ─ console.upstash.com → la base → REST API
UPSTASH_REDIS_REST_URL=                  # [R]
UPSTASH_REDIS_REST_TOKEN=                # [R]

# ── Imágenes (Cloudinary) ─ Dashboard → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=                      # [R]
CLOUDINARY_API_SECRET=                   # [R]

# ── Pase QR firmado ─ node tools/generate-qr-keys.mjs (un par distinto por entorno)
QR_SIGNING_PRIVATE_KEY=                  # [R]
NEXT_PUBLIC_QR_PUBLIC_KEY=               # [R]
QR_REQUIRE_SIGNED=true

# ── Sitio y observabilidad
NEXT_PUBLIC_SITE_URL=https://tudominio.com # [R]
SENTRY_DSN=                              # [R] sentry.io → proyecto → Client Keys (DSN)
