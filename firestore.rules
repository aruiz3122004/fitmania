rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validación de Role system Backend -> Frontend
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isReceptionist() {
      return isSignedIn() && request.auth.token.receptionist == true;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isReceptionist());
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.autor_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.autor_id == request.auth.uid);
    }

    match /pqrs/{pqrsId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin() || isReceptionist());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Rate limiting para contadores o logs futuros
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /planes/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin() || isReceptionist());
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // Registro de Entradas (Historial empresarial de ingresos)
    match /entry_logs/{logId} {
      allow read: if isAdmin() || isReceptionist();
      allow write: if false; // Solo el Admin SDK desde el servidor puede escribir aquí.
    }

    // Registro de Check-ins (Historial individual para el dashboard de recepción)
    match /checkIns/{checkInId} {
      allow read: if isAdmin() || isReceptionist();
      allow write: if isAdmin() || isReceptionist();
    }

    // Auditoría de Seguridad e Inmutable
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Solo el Admin SDK desde el servidor puede escribir aquí.
    }

    // Reportes de usuarios
    match /reportes/{reporteId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
