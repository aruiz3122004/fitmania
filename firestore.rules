rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Validación de Role system Backend -> Frontend
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // F1-06: publicar en el foro exige correo verificado.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Recepción NO accede a Firestore desde el navegador: todo pasa por /api/recepcion/*
    // (el servidor verifica el claim `receptionist` y devuelve datos mínimos).

    // Campos del perfil que el propio usuario puede escribir. `plan` NUNCA está aquí:
    // solo lo escribe el servidor (webhook de pagos / panel admin vía Admin SDK).
    function editableProfileKeys() {
      return ['username', 'avatar', 'photoURL', 'peso', 'altura', 'gender'];
    }

    match /users/{uid} {
      // F2-18: recepción ya no lee `users` directo; usa /api/recepcion/members (datos mínimos).
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // F1-06: el perfil lo crea el servidor (/api/users/register) con el plan vacío;
      // el cliente no puede crear su documento (cerraba B2: autoasignarse un plan).
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableProfileKeys()));
      allow delete: if isAdmin();
    }

    // Un like válido cambia la lista SOLO en el uid de quien lo hace (agrega o quita).
    function isOwnLikeToggle() {
      let before = resource.data.get('likes', []).toSet();
      let after = request.resource.data.get('likes', []).toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.autor_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['autor_id', 'autor_username', 'autor_avatar', 'autor_is_premium',
             'contenido', 'imagen_url', 'imagen_public_id', 'tipo_recurso', 'likes', 'comentarios', 'created_at'])
        && request.resource.data.contenido is string
        && request.resource.data.contenido.size() <= 2000
        && request.resource.data.get('likes', []).size() == 0
        && request.resource.data.get('comentarios', []).size() == 0;
      // Autor: edita su contenido y modera su post. Terceros: solo su like (los comentarios van en la subcolección).
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.autor_id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contenido', 'likes', 'comentarios', 'autor_avatar'])
            && request.resource.data.contenido is string
            && request.resource.data.contenido.size() <= 2000)
        || (isSignedIn() && isOwnLikeToggle());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.autor_id == request.auth.uid);
    }

    // F1-07: comentarios como documentos propios. El autor edita/borra el suyo; el
    // autor del post y el admin pueden moderar (borrar) cualquiera del post.
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isVerified()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.autor_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['autor_id', 'autor_username', 'autor_avatar', 'autor_is_premium',
             'contenido', 'created_at'])
        && request.resource.data.contenido is string
        && request.resource.data.contenido.size() > 0
        && request.resource.data.contenido.size() <= 1000;
      allow update: if isSignedIn()
        && resource.data.autor_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contenido', 'edited_at'])
        && request.resource.data.contenido is string
        && request.resource.data.contenido.size() > 0
        && request.resource.data.contenido.size() <= 1000;
      allow delete: if isAdmin()
        || (isSignedIn() && (resource.data.autor_id == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.autor_id == request.auth.uid));
    }

    match /pqrs/{pqrsId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      // F1-29: campos conocidos, autor y correo del token, tamaño acotado y estado inicial fijo.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['tipo', 'mensaje', 'userId', 'userName', 'userEmail',
             'fecha', 'hora', 'createdAt', 'status'])
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() > 0
        && request.resource.data.mensaje.size() <= 3000
        && request.resource.data.tipo is string
        && request.resource.data.tipo.size() <= 40
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Rate limiting para contadores o logs futuros
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if false; // Solo el Admin SDK escribe logs (T-08, auditoría B-5)
      allow update, delete: if false;
    }

    match /planes/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if false; // Solo el webhook de Stripe (Admin SDK) crea órdenes (T-08, auditoría M-3)
      allow update: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // Registro de Entradas (Historial empresarial de ingresos)
    match /entry_logs/{logId} {
      allow read: if isAdmin(); // Recepción consulta vía /api/recepcion/entry-log
      allow write: if false; // Solo el Admin SDK desde el servidor puede escribir aquí.
    }

    // Registro de Check-ins (Historial individual para el dashboard de recepción)
    match /checkIns/{checkInId} {
      allow read: if isAdmin(); // Recepción consulta vía /api/recepcion/members/:uid
      allow write: if false; // F2-03: lo escribe el servidor junto con entry_logs (transacción).
    }

    // Auditoría de Seguridad e Inmutable
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Solo el Admin SDK desde el servidor puede escribir aquí.
    }

    // Noticias del foro (F3-16): las administra el panel vía API; el público lee las publicadas.
    match /news/{newsId} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    // Reportes de usuarios
    match /reportes/{reporteId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reportante_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['reportante', 'reportante_id', 'publicacion_id', 'autor_publicacion',
             'motivo', 'fecha_publicacion', 'fecha_reporte'])
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() <= 500;
      allow update, delete: if isAdmin();
    }
  }
}
