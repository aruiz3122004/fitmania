rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validación de Role system Backend -> Frontend
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read, update: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow delete: if false; // Ni el admin borra usuarios directamente desde db sin pasar por Auth.
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.autor_id == request.auth.uid
        && request.resource.data.keys().hasAll([
          'autor_id',
          'autor_username',
          'autor_avatar',
          'contenido',
          'imagen_url',
          'likes',
          'comentarios',
          'created_at'
        ]);

      // Modificación o likes
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comentarios']);

      // El admin puede moderar posts
      allow delete: if (isSignedIn() && resource.data.autor_id == request.auth.uid) || isAdmin();
    }

    match /pqrs/{pqrsId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Admin puede actualizar estado de PQRS (ej. resuelto) o borrar
      allow update, delete: if isAdmin();
    }

    // Rate limiting para contadores o logs futuros
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /planes/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if isAdmin(); // Solo el webhook (SDK Admin) o el admin real crean órdenes.
    }

    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // Registro de Entradas (Historial empresarial de ingresos)
    match /entry_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Solo el Admin SDK desde el servidor puede escribir aquí.
    }

    // Auditoría de Seguridad e Inmutable
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Solo el Admin SDK desde el servidor puede escribir aquí.
    }
  }
}
